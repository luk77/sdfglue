<?xml version="1.0" encoding="UTF-8"?>
<FuncDef groupName="Symmetries" displayName="Symmetry Z" functionName="opSymmetryZ">
<Parameters>
  <Param type="float" displayName="Offset Z" parameterName="offsetZ" default="0.0" speed="0.01"/>
</Parameters>
<Code>
