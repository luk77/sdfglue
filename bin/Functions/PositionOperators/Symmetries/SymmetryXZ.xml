<?xml version="1.0" encoding="UTF-8"?>
<FuncDef groupName="Symmetries" displayName="Symmetry XZ" functionName="opSymmetryXZ">
<Parameters>
  <Param type="float" displayName="Offset X" parameterName="offsetX" default="0.0" speed="0.01"/>
  <Param type="float" displayName="Offset Z" parameterName="offsetZ" default="0.0" speed="0.01"/>
</Parameters>
<Code>
<![CDATA[
void opSymmetryXZ(inout vec3 p, float offsetX, float offsetZ)
{
    p.xz = abs(p.xz) - vec2(offsetX, offsetZ);
}
]]>
</Code>
</FuncDef>