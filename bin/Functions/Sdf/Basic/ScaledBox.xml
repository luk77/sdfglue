<?xml version="1.0" encoding="UTF-8"?>
<FuncDef groupName="Basic" displayName="Box (scaled)" functionName="sdScaledBox">
<Parameters>
  <Param type="vec3" displayName="Dimensions (half)" parameterName="dim" default="0.5;0.5;0.5" speed="0.01"/>
  <Param type="float" displayName="Scale" 			parameterName="scale" default="1.0" speed="0.01"/>
</Parameters>
<References>https://iquilezles.org/articles/distfunctions/</References>
<Code>
<![CDATA[
float sdScaledBox(in vec3 p, in vec3 dim, in float scale)
{
    vec3 q = abs(p) - dim * scale;
    return length(max(q,0.0)) + min(max(q.x,max(q.y,q.z)),0.0);
}
]]>
</Code>
</FuncDef>