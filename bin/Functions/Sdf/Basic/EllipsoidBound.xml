<?xml version="1.0" encoding="UTF-8"?>
<FuncDef groupName="Basic" displayName="Ellipsoid (bound)" functionName="sdEllipsoidBound">
<Parameters>
  <Param type="vec3" displayName="Dimensions (half)" parameterName="dim" default="0.5;0.5;0.5" speed="0.01"/>
</Parameters>
<References>https://iquilezles.org/articles/distfunctions/</References>
<Code>
<![CDATA[
float sdEllipsoidBound(in vec3 p, in vec3 dim)
{
  float k0 = length(p/dim);
  float k1 = length(p/(dim*dim));
  return k0*(k0-1.0)/k1;
}
]]>
</Code>
</FuncDef>