<?xml version="1.0" encoding="UTF-8"?>
<FuncDef groupName="Symmetries" displayName="Smooth Symmetry Y" functionName="opSmoothSymmetryY">
<Parameters>
  <Param type="float" displayName="Offset Y"    parameterName="offsetY"         default="0.0" speed="0.01"/>
  <Param type="float" displayName="Smoothness"  parameterName="smoothnessY"     default="0.0" speed="0.0001"/>
</Parameters>
<Code>
<![CDATA[
void opSmoothSymmetryY(inout vec3 p, float offset, float smoothnessY)
{
    //p.y = abs(p.y) - offset;
    p.y = sqrt(p.y*p.y + smoothnessY) - offset;
}
]]>
</Code>
</FuncDef>