<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>True</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>SdfGlueEditor.Program</StartupObject>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <AssemblyName>SdfGlue</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.9.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SdfGlueCore\SdfGlueCore.csproj" />
    <ProjectReference Include="..\SdfGlueUi\SdfGlueUi.csproj" />
    <ProjectReference Include="..\SingleDocAppFramework\SingleDocAppFramework.csproj" />
    <ProjectReference Include="..\SingleDocAppPlatformWin\SingleDocAppPlatformWin.csproj" />
    <ProjectReference Include="..\SingleDocAppMidiWin\SingleDocAppMidiWin.csproj" />
  </ItemGroup>

</Project>